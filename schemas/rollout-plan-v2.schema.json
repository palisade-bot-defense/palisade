{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palisade.invalid/schemas/rollout-plan-v2.schema.json",
  "title": "PALISADE signed rollout plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "signature"],
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "rollout_id", "approval_id", "predecessor_rollout_id", "created_at", "expires_at", "source_report_sha256", "source_readiness_state", "policy_version", "model_version", "stage", "endpoint_classes", "max_action", "canary_basis_points", "throttle_seconds", "challenge_ttl_seconds", "block_seconds", "min_mature_challenges", "min_challenge_outcome_coverage", "max_challenge_abandonment_rate", "max_challenge_fallback_rate"],
      "properties": {
        "schema_version": { "const": "palisade.rollout-plan.v2" },
        "rollout_id": { "$ref": "#/$defs/id" },
        "approval_id": { "$ref": "#/$defs/id" },
        "predecessor_rollout_id": { "type": "string", "maxLength": 64 },
        "created_at": { "$ref": "#/$defs/time" },
        "expires_at": { "$ref": "#/$defs/time" },
        "source_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_readiness_state": { "const": "operator_review_candidate" },
        "policy_version": { "$ref": "#/$defs/id" },
        "model_version": { "$ref": "#/$defs/id" },
        "stage": { "enum": ["canary", "enforce"] },
        "endpoint_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["public_content", "compare_index", "compare_noindex", "other_public"] }
        },
        "max_action": { "enum": ["delay", "throttle", "challenge", "block"] },
        "canary_basis_points": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "throttle_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "challenge_ttl_seconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "block_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "min_mature_challenges": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "min_challenge_outcome_coverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_challenge_abandonment_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_challenge_fallback_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "canary" } } },
          "then": {
            "properties": {
              "max_action": { "enum": ["delay", "throttle", "challenge"] },
              "canary_basis_points": { "maximum": 1000 },
              "predecessor_rollout_id": { "const": "" }
            }
          }
        },
        {
          "if": { "properties": { "stage": { "const": "enforce" } } },
          "then": { "properties": { "canary_basis_points": { "const": 10000 }, "predecessor_rollout_id": { "$ref": "#/$defs/id" } } }
        }
      ]
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,63}$" },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}

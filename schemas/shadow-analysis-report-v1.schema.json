{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palisade.invalid/schemas/shadow-analysis-report-v1.schema.json",
  "title": "PALISADE aggregate shadow analysis report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "readiness", "decisions", "outcomes", "scores", "endpoints", "top_reason_codes", "policy_versions", "model_versions", "canary_rollouts", "recommendations"],
  "properties": {
    "schema_version": { "const": "palisade.shadow-analysis.v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "records", "decisions", "outcomes", "encrypted_bytes"],
      "properties": {
        "files": { "$ref": "#/$defs/count" },
        "records": { "$ref": "#/$defs/count" },
        "decisions": { "$ref": "#/$defs/count" },
        "outcomes": { "$ref": "#/$defs/count" },
        "encrypted_bytes": { "type": "integer", "minimum": 0 },
        "first_at": { "$ref": "#/$defs/time" },
        "last_at": { "$ref": "#/$defs/time" }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "operator_action", "automatic_enforcement", "reason_codes"],
      "properties": {
        "state": { "enum": ["collecting", "needs_labels", "needs_tuning", "operator_review_candidate", "invalid_shadow_behavior"] },
        "operator_action": { "enum": ["remain_shadow", "review_reversible_canary"] },
        "automatic_enforcement": { "const": false },
        "reason_codes": { "type": "array", "items": { "$ref": "#/$defs/code" }, "maxItems": 16 }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "enforced", "computed", "modes", "shadow_risky_enforcements", "computed_challenge_rate"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "enforced": { "$ref": "#/$defs/actions" },
        "computed": { "$ref": "#/$defs/actions" },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shadow", "canary", "enforce"],
          "properties": { "shadow": { "$ref": "#/$defs/count" }, "canary": { "$ref": "#/$defs/count" }, "enforce": { "$ref": "#/$defs/count" } }
        },
        "shadow_risky_enforcements": { "$ref": "#/$defs/count" },
        "computed_challenge_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "coverage", "successful_action", "challenge_passed", "challenge_failed", "challenge_abandoned", "human_confirmed", "operator_confirmed_abuse", "appeal_requested", "fallback_used", "unknown", "challenge_results", "challenge_failure_rate"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "coverage": { "$ref": "#/$defs/ratio" },
        "successful_action": { "$ref": "#/$defs/count" },
        "challenge_passed": { "$ref": "#/$defs/count" },
        "challenge_failed": { "$ref": "#/$defs/count" },
        "challenge_abandoned": { "$ref": "#/$defs/count" },
        "human_confirmed": { "$ref": "#/$defs/count" },
        "operator_confirmed_abuse": { "$ref": "#/$defs/count" },
        "appeal_requested": { "$ref": "#/$defs/count" },
        "fallback_used": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" },
        "challenge_results": { "$ref": "#/$defs/count" },
        "challenge_failure_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_risk", "abuse_intent_risk", "account_continuity"],
      "properties": {
        "automation_risk": { "$ref": "#/$defs/score_summary" },
        "abuse_intent_risk": { "$ref": "#/$defs/score_summary" },
        "account_continuity": { "$ref": "#/$defs/score_summary" }
      }
    },
    "endpoints": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint_class", "decisions", "outcomes", "computed_risky_actions", "human_confirmed", "operator_confirmed_abuse"],
        "properties": {
          "endpoint_class": { "$ref": "#/$defs/endpoint" },
          "decisions": { "$ref": "#/$defs/count" },
          "outcomes": { "$ref": "#/$defs/count" },
          "computed_risky_actions": { "$ref": "#/$defs/count" },
          "human_confirmed": { "$ref": "#/$defs/count" },
          "operator_confirmed_abuse": { "$ref": "#/$defs/count" }
        }
      }
    },
    "top_reason_codes": { "$ref": "#/$defs/counted_values" },
    "policy_versions": { "$ref": "#/$defs/counted_values" },
    "model_versions": { "$ref": "#/$defs/counted_values" },
    "canary_rollouts": { "$ref": "#/$defs/counted_values" },
    "recommendations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "priority", "disposition", "metric", "observed", "threshold", "unit", "message"],
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "priority": { "enum": ["critical", "high", "medium", "low"] },
          "disposition": { "enum": ["required", "hold", "review_candidate"] },
          "metric": { "$ref": "#/$defs/code" },
          "observed": { "type": "number", "minimum": 0 },
          "threshold": { "type": "number", "minimum": 0 },
          "unit": { "enum": ["count", "ratio", "boolean"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "code": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "endpoint": { "enum": ["public_content", "compare_index", "compare_noindex", "challenge_worker", "other_public", "account", "login", "checkout", "other"] },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "observe", "throttle", "challenge", "block"],
      "properties": {
        "allow": { "$ref": "#/$defs/count" },
        "observe": { "$ref": "#/$defs/count" },
        "throttle": { "$ref": "#/$defs/count" },
        "challenge": { "$ref": "#/$defs/count" },
        "block": { "$ref": "#/$defs/count" }
      }
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "mean"],
      "properties": {
        "minimum": { "$ref": "#/$defs/ratio" },
        "maximum": { "$ref": "#/$defs/ratio" },
        "mean": { "$ref": "#/$defs/ratio" }
      }
    },
    "counted_values": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "count"],
        "properties": { "value": { "$ref": "#/$defs/code" }, "count": { "$ref": "#/$defs/count" } }
      }
    }
  }
}

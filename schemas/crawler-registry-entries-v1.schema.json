{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palisade.bot/schemas/crawler-registry-entries-v1.schema.json",
  "title": "PALISADE reviewed crawler registry entries v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 128,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "class", "user_agent_tokens", "cidrs"],
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[!-~]+$" },
      "class": {
        "type": "string",
        "enum": ["search_indexer", "answer_engine", "training_crawler", "user_triggered_agent", "preview", "monitoring", "other"]
      },
      "user_agent_tokens": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 5, "maxLength": 64, "pattern": "^[!-~]+$" }
      },
      "cidrs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": { "type": "string", "minLength": 3, "maxLength": 64 }
      }
    }
  }
}

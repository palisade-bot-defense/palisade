{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palisade.invalid/schemas/rollout-review-v4.schema.json",
  "title": "PALISADE deterministic rollout review proposal v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_report_sha256", "source_schema_version", "source_first_at", "source_last_at", "policy_version", "model_version", "state", "automatic_activation", "requested_stage", "predecessor_rollout_id", "recommended_scope", "gates", "operator_checklist"],
  "properties": {
    "schema_version": { "const": "palisade.rollout-review.v4" },
    "source_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_schema_version": { "const": "palisade.shadow-analysis.v4" },
    "source_first_at": { "$ref": "#/$defs/optional_time" },
    "source_last_at": { "$ref": "#/$defs/optional_time" },
    "policy_version": { "type": "string", "maxLength": 64 },
    "model_version": { "type": "string", "maxLength": 64 },
    "state": { "enum": ["hold", "review_candidate"] },
    "automatic_activation": { "const": false },
    "requested_stage": { "enum": ["canary", "enforce"] },
    "predecessor_rollout_id": { "type": "string", "maxLength": 64 },
    "recommended_scope": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/scope" }] },
    "gates": { "type": "array", "minItems": 5, "maxItems": 10, "items": { "$ref": "#/$defs/gate" } },
    "operator_checklist": {
      "type": "array",
      "prefixItems": [
        { "const": "confirm_endpoint_confidence_intervals" },
        { "const": "confirm_accessible_fallback_and_support" },
        { "const": "confirm_origin_adapter_fail_safe_behavior" },
        { "const": "confirm_rollback_owner_and_command" }
      ],
      "items": false, "minItems": 4, "maxItems": 4
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,63}$" },
    "time": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "optional_time": { "oneOf": [{ "const": "" }, { "$ref": "#/$defs/time" }] },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["code", "status", "observed", "required", "message"],
      "properties": {
        "code": { "enum": ["REPORT_READINESS", "OBSERVATION_WINDOW", "POLICY_VERSION_DOMINANCE", "MODEL_VERSION_DOMINANCE", "ELIGIBLE_ENDPOINT_SCOPE", "PREDECESSOR_ENDPOINT_CANARY", "PREDECESSOR_CHALLENGE_SAMPLE", "CHALLENGE_OUTCOME_COVERAGE_BUDGET", "CHALLENGE_ABANDONMENT_BUDGET", "CHALLENGE_FALLBACK_BUDGET"] },
        "status": { "enum": ["pass", "hold"] },
        "observed": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_classes", "max_action", "canary_basis_points", "duration_seconds", "throttle_seconds", "challenge_ttl_seconds", "block_seconds", "min_mature_challenges", "min_challenge_outcome_coverage", "max_challenge_abandonment_rate", "max_challenge_fallback_rate"],
      "properties": {
        "endpoint_classes": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "enum": ["public_content", "compare_index", "compare_noindex", "other_public"] } },
        "max_action": { "const": "challenge" },
        "canary_basis_points": { "enum": [100, 10000] },
        "duration_seconds": { "enum": [43200, 86400] },
        "throttle_seconds": { "const": 5 }, "challenge_ttl_seconds": { "const": 300 }, "block_seconds": { "const": 300 },
        "min_mature_challenges": { "const": 100 }, "min_challenge_outcome_coverage": { "const": 0.9 },
        "max_challenge_abandonment_rate": { "const": 0.1 }, "max_challenge_fallback_rate": { "const": 0.1 }
      }
    }
  }
}

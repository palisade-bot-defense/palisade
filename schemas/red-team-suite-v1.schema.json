{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palisade.invalid/schemas/red-team-suite-v1.schema.json",
  "title": "PALISADE synthetic red-team suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "synthetic_only", "network_policy", "scenarios"],
  "properties": {
    "schema_version": { "const": "palisade.red-team-suite.v1" },
    "scope": { "const": "roadmap_v0_9_synthetic_baseline" },
    "synthetic_only": { "const": true },
    "network_policy": { "const": "module_downloads_disabled" },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "asset", "threat", "expected", "test_refs"],
        "properties": {
          "id": {
            "enum": [
              "browser_challenge_humanity_evasion",
              "verified_crawler_intent_evasion",
              "signed_edge_payload_poisoning",
              "signed_policy_threshold_poisoning",
              "native_challenge_redemption_relay",
              "origin_flow_binding_relay",
              "anonymous_session_reset",
              "expired_event_receipt_reset",
              "session_store_capacity_exhaustion",
              "offline_import_budget_exhaustion",
              "signed_rollout_tampering",
              "expired_rollout_reuse"
            ]
          },
          "category": {
            "enum": ["evasion", "poisoning", "proof_relay", "session_reset", "resource_exhaustion", "rollout_compromise"]
          },
          "asset": {
            "enum": ["decision_integrity", "trusted_signal_boundary", "challenge_capability", "session_continuity", "bounded_availability", "rollout_authority"]
          },
          "threat": { "type": "string", "minLength": 1, "maxLength": 180 },
          "expected": {
            "enum": [
              "challenge_pass_never_confirms_human",
              "verified_identity_cannot_override_abuse_intent",
              "reject_noncanonical_or_inconsistent_signal",
              "reject_uncompiled_or_invalid_policy",
              "reject_replay_or_binding_mismatch",
              "bind_grant_to_target_sequence_session_and_instance",
              "new_session_is_isolated_and_not_verified",
              "expire_receipt_and_start_fresh_sequence",
              "evict_within_fixed_capacity",
              "fail_closed_without_published_output",
              "reject_tampered_or_mismatched_rollout",
              "downgrade_expired_rollout_to_shadow"
            ]
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+_test\\.go#Test[A-Za-z0-9_]+$",
              "maxLength": 180
            }
          }
        }
      }
    }
  }
}
